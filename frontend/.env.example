# Optional overrides. By default the app reads src/contracts/deployment.json,
# which `npx hardhat run scripts/deploy.ts --network arbitrumSepolia` writes for you.
VITE_SOD_ADDRESS=
VITE_TOKEN_ADDRESS=
VITE_SOD_CONF_ADDRESS=
VITE_ECUSDG_ADDRESS=

# ZeroDev project ID (https://dashboard.zerodev.app), used for sign-in with Google, passkey or email.
# In the dashboard: allow your app origin, add your redirect URL under Google OAuth,
# and enable Arbitrum Sepolia.
VITE_ZERODEV_PROJECT_ID=
